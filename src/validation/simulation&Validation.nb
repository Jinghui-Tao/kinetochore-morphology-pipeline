       RowBox[{
        RowBox[{"safeGaussianPsfValue", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", "psfCoordinateRange"}], "}"}], ",", 
        RowBox[{"{", 
