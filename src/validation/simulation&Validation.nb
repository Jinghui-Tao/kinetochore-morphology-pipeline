        RowBox[{"length", "."}]}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ovalBenchmarkPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
