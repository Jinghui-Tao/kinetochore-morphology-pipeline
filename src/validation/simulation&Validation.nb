          RowBox[{"row", "[", "\"\<Image\>\"", "]"}]}]}], "]"}], ",", "160"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Final", " ", "notebook", " ", 
