           RowBox[{"regionFunction", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"xPixel", "+", "dx"}], ")"}], " ", "pixelSizeUm"}], ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"yPixel", "+", "dy"}], ")"}], " ", "pixelSizeUm"}]}], 
            "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"dx", ",", "subpixelOffsets"}], "}"}], ",", 
         RowBox[{"{", 
