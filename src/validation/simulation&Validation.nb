     "for", " ", "the", " ", "displayed", " ", "measurement", " ", 
     RowBox[{"table", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"measurementColumns", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Condition\>\"", ",", "\"\<Ground-truth bead size (nm)\>\"",
        ",", "\"\<End-to-end length d (nm)\>\"", ",", "\"\<Width (nm)\>\"", 
