     RowBox[{"makeMask", "[", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xUm", ",", "yUm"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"xUm", "^", "2"}], "+", 
           RowBox[{"yUm", "^", "2"}]}], "<", 
