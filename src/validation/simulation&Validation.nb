         "}"}], ",", 
       RowBox[{
        RowBox[{"signalMatrix", "=", 
         RowBox[{"simulateSignalMatrix", "[", "maskMatrix", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"profile", "=", 
         RowBox[{"profileAlongLength", "[", "signalMatrix", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"aucPixels", "=", 
         RowBox[{"aucOverFmaxPixels", "[", "profile", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fwhmPixels", "=", 
         RowBox[{"interpolatedFwhmPixels", "[", 
          RowBox[{"profile", ",", "0.5"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{"\"\<Condition\>\"", "->", "condition"}], "|>"}], ",", 
          "metadata", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<AUC/fmax length (nm)\>\"", "->", 
             RowBox[{"toNanometers", "[", "aucPixels", "]"}]}], ",", 
            RowBox[{"\"\<FWHM length (nm)\>\"", "->", 
             RowBox[{"toNanometers", "[", "fwhmPixels", "]"}]}], ",", 
            RowBox[{"\"\<Image\>\"", "->", 
             RowBox[{"ImageAdjust", "[", 
              RowBox[{"Image", "[", 
               RowBox[{"signalMatrix", ",", "\"\<Real\>\""}], "]"}], 
              "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Circular", "-", 
     RowBox[{"bead", " ", 
      RowBox[{"benchmark", ":", 
       RowBox[{"compare", " ", "the", " ", "measured", " ", 
        RowBox[{"AUC", "/", "fmax"}], " ", "and", " ", "FWHM", " ", "lengths",
         " ", "against", " ", "known", " ", "bead", " ", 
        RowBox[{"diameters", "."}]}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"beadDiameterNmValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"100", ",", "1000", ",", "100"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diskSimulationRows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"measureSignal", "[", 
        RowBox[{"\"\<Circular bead\>\"", ",", 
         RowBox[{"diskMask", "[", 
          RowBox[{"diameterNm", "/", "1000"}], "]"}], ",", 
         RowBox[{"<|", 
          RowBox[{"\"\<Ground-truth bead size (nm)\>\"", "->", "diameterNm"}],
           "|>"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"diameterNm", ",", "beadDiameterNmValues"}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Oval", "-", 
     RowBox[{"signal", " ", 
      RowBox[{"benchmark", ":", 
       RowBox[{
        RowBox[{"keep", " ", "the", " ", "short"}], "-", 
        RowBox[{
        "axis", " ", "width", " ", "fixed", " ", "and", " ", "vary", " ", 
         "the", " ", "long"}], "-", 
        RowBox[{"axis", " ", "end"}], "-", "to", "-", 
        RowBox[{"end", " ", 
         RowBox[{"length", "."}]}]}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ovalWidthNm", "=", "300"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ovalLengthNmValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"300", ",", "1000", ",", "100"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ovalSimulationRows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"measureSignal", "[", 
        RowBox[{"\"\<Oval signal\>\"", ",", 
         RowBox[{"ovalMask", "[", 
          RowBox[{
           RowBox[{"lengthNm", "/", "1000"}], ",", 
           RowBox[{"ovalWidthNm", "/", "1000"}]}], "]"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<End-to-end length d (nm)\>\"", "->", "lengthNm"}], ",", 
           RowBox[{"\"\<Width (nm)\>\"", "->", "ovalWidthNm"}]}], "|>"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"lengthNm", ",", "ovalLengthNmValues"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Tail", "-", 
      RowBox[{"signal", " ", 
       RowBox[{"benchmark", ":", 
        RowBox[{
        "keep", " ", "the", " ", "circular", " ", "core", " ", "and", " ", 
         "tail", " ", "width", " ", "fixed"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"then", " ", "vary", " ", "the", " ", "one"}], "-", 
      RowBox[{"sided", " ", "tail", " ", 
       RowBox[{"length", "."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tailCoreDiameterNm", "=", "500"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tailWidthNm", "=", "200"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tailLengthNmValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"100", ",", "1000", ",", "100"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tailSimulationRows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"measureSignal", "[", 
        RowBox[{"\"\<Disk with tail\>\"", ",", 
         RowBox[{"tailMask", "[", 
          RowBox[{
           RowBox[{"tailCoreDiameterNm", "/", "1000"}], ",", 
           RowBox[{"tailLengthNm", "/", "1000"}], ",", 
           RowBox[{"tailWidthNm", "/", "1000"}]}], "]"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Core diameter (nm)\>\"", "->", "tailCoreDiameterNm"}],
            ",", 
           RowBox[{"\"\<Tail length x (nm)\>\"", "->", "tailLengthNm"}], ",", 
           RowBox[{"\"\<Tail width (nm)\>\"", "->", "tailWidthNm"}]}], 
          "|>"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"tailLengthNm", ",", "tailLengthNmValues"}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Combine", " ", "all", " ", "simulated", " ", "measurements", " ", 
      "into", " ", "one", " ", "table"}], "-", 
     RowBox[{"ready", " ", "result", " ", 
      RowBox[{"list", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"simulationRows", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
      "diskSimulationRows", ",", "ovalSimulationRows", ",", 
       "tailSimulationRows"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "numeric", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], " ", "pairs", " ", "for", " ", 
     "plotting", " ", "and", " ", "ignore", " ", "missing", " ", 
     RowBox[{"values", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"numericSeries", "[", 
      RowBox[{"rows_", ",", "xKey_", ",", "yKey_"}], "]"}], ":=", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"#", ",", "xKey", ",", 
              RowBox[{"Missing", "[", "]"}]}], "]"}], ",", 
            RowBox[{"Lookup", "[", 
             RowBox[{"#", ",", "yKey", ",", 
              RowBox[{"Missing", "[", "]"}]}], "]"}]}], "}"}], "&"}], ")"}], "/@",
         "rows"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x_", "?", "NumericQ"}], ",", 
         RowBox[{"y_", "?", "NumericQ"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
