           "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"bValue", "=", 
        RowBox[{"b", "/.", " ", "fit"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fwhmPixels", "=", 
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"Log", "[", "2", "]"}], "/", "bValue"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fittedData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"model", "/.", " ", "fit"}], "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "->", "xx"}], ",", 
             RowBox[{"y", "->", "yy"}]}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"yy", ",", "1", ",", "roiHeight"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xx", ",", "1", ",", "roiWidth"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"residual", "=", 
        RowBox[{"roiData", "-", "fittedData"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"totalVariance", "=", 
        RowBox[{"roiData", "-", 
         RowBox[{"Mean", "[", 
          RowBox[{"Flatten", "[", "roiData", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"r2", "=", 
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", "residual", "]"}], "^", "2"}], "]"}], "/", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", "totalVariance", "]"}], "^", "2"}], 
           "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Channel\>\"", "->", "channelIndex"}], ",", 
         RowBox[{"\"\<Peak X\>\"", "->", "peakX"}], ",", 
         RowBox[{"\"\<Peak Y\>\"", "->", "peakY"}], ",", 
         RowBox[{"\"\<Peak intensity\>\"", "->", 
          RowBox[{"Max", "[", "roiData", "]"}]}], ",", 
         RowBox[{"\"\<Background\>\"", "->", "background"}], ",", 
         RowBox[{"\"\<Peak minus background\>\"", "->", "amplitude"}], ",", 
         RowBox[{"\"\<psfCoefficient\>\"", "->", "bValue"}], ",", 
         RowBox[{"\"\<FWHM pixels\>\"", "->", "fwhmPixels"}], ",", 
         RowBox[{"\"\<FWHM nm\>\"", "->", 
          RowBox[{"fwhmPixels", "*", "pixelSizeUm", "*", "1000"}]}], ",", 
         RowBox[{"\"\<R2\>\"", "->", "r2"}], ",", 
         RowBox[{"\"\<Projection image\>\"", "->", 
          RowBox[{"ImageAdjust", "[", 
           RowBox[{"Image", "[", 
            RowBox[{"data", ",", "\"\<Real\>\""}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<ROI image\>\"", "->", 
          RowBox[{"ImageAdjust", "[", 
           RowBox[{"Image", "[", 
            RowBox[{"roiData", ",", "\"\<Real\>\""}], "]"}], "]"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psfFitByChannel", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"fitProjectedBeadPsf", "[", 
       RowBox[{
        RowBox[{"channelProjectionData", "[", 
         RowBox[{"[", "ch", "]"}], "]"}], ",", "ch"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ch", ",", "1", ",", "channelNumber"}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"validChannelFits", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"psfFitByChannel", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "#", "]"}], "&&", 
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", "\"\<psfCoefficient\>\"", "]"}], "]"}], "&&", 
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", "\"\<R2\>\"", "]"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"#", "[", "\"\<R2\>\"", "]"}], ">", "0.9"}], "&&", 
        RowBox[{"1.5", "<=", 
         RowBox[{"#", "[", "\"\<FWHM pixels\>\"", "]"}], "<=", "4.0"}]}], 
       "&"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"recommendedPsfCoefficient", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "validChannelFits", "]"}], ">", "0"}], ",", 
      RowBox[{"Median", "[", 
       RowBox[{"validChannelFits", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<psfCoefficient\>\""}], "]"}], "]"}], "]"}], 
      ",", 
      RowBox[{"Missing", "[", "\"\<NoGoodFits\>\"", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"recommendedFwhmPixels", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumberQ", "[", "recommendedPsfCoefficient", "]"}], ",", 
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Log", "[", "2", "]"}], "/", "recommendedPsfCoefficient"}], 
        "]"}]}], ",", 
      RowBox[{"Missing", "[", "\"\<NoGoodFits\>\"", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"recommendedFwhmNm", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumberQ", "[", "recommendedFwhmPixels", "]"}], ",", 
      RowBox[{"recommendedFwhmPixels", "*", "pixelSizeUm", "*", "1000"}], ",", 
      RowBox[{"Missing", "[", "\"\<NoGoodFits\>\"", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Channel sum projections\>\"", ",", "14", ",", "Bold"}], 
      "]"}], ",", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Ch\>\"", "<>", 
              RowBox[{"ToString", "[", "ch", "]"}]}], ",", "Bold"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"ch", ",", "1", ",", "channelNumber"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ImageResize", "[", 
            RowBox[{"#", ",", "180"}], "]"}], "&"}], "/@", 
          "channelProjectionImages"}]}], "}"}], ",", 
       RowBox[{"Alignment", "->", "Center"}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Projected-channel PSF fit summary\>\"", ",", "14", ",", 
       "Bold"}], "]"}], ",", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<pixelSizeUm\>\"", ",", "pixelSizeUm"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<projectionMethod\>\"", ",", "projectionMethod"}], 
          "}"}], ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<recommended psfCoefficient\>\"", ",", 
           "recommendedPsfCoefficient"}], "}"}], ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<recommended FWHM pixels\>\"", ",", 
           "recommendedFwhmPixels"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<recommended FWHM nm\>\"", ",", "recommendedFwhmNm"}], 
          "}"}]}], "}"}], ",", 
       RowBox[{"Alignment", "->", "Left"}]}], "]"}], ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Fit results by channel\>\"", ",", "14", ",", "Bold"}], 
      "]"}], ",", 
     RowBox[{"Dataset", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"KeyDrop", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Projection image\>\"", ",", "\"\<ROI image\>\""}], 
           "}"}]}], "]"}], "&"}], "/@", "psfFitByChannel"}], "]"}], ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Fitted bead ROI by channel\>\"", ",", "14", ",", "Bold"}], 
      "]"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"psfFitByChannel", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<ROI image\>\""}], "]"}], "]"}], ",", 
           "_Image"}], "]"}], "]"}], ">", "0"}], ",", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"ImageResize", "[", 
             RowBox[{"#", ",", "120"}], "]"}], "&"}], "/@", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"psfFitByChannel", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "\"\<ROI image\>\""}], "]"}], "]"}], ",", 
             "_Image"}], "]"}]}], "}"}], ",", 
         RowBox[{"Spacings", "->", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<No ROI images available.\>\"", ",", "Italic", ",", 
         "Gray"}], "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Spacings", "->", "1.2"}]}], "]"}]}], "Input",
