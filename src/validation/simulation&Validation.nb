   RowBox[{
    RowBox[{"psfKernelImage", "=", 
     RowBox[{"Image", "[", 
      RowBox[{"psfKernelMatrix", ",", "\"\<Real\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
