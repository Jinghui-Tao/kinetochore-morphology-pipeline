       RowBox[{"ImageSize", "->", "620"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "tail", " ", 
     RowBox[{"signals", ":", 
      RowBox[{
      "this", " ", "shows", " ", "how", " ", "each", " ", "metric", " ", 
       "responds", " ", "as", " ", "dim", " ", "asymmetric", " ", "signal", " ",
        "is", " ", "added", " ", "to", " ", "one", " ", 
       RowBox[{"side", "."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tailBenchmarkPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"numericSeries", "[", 
          RowBox[{
          "tailSimulationRows", ",", "\"\<Tail length x (nm)\>\"", 
           ",", "\"\<AUC/fmax length (nm)\>\""}], "]"}], ",", 
         RowBox[{"numericSeries", "[", 
          RowBox[{
