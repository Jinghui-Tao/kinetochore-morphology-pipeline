       "measurements", " ", "against", " ", "ground", " ", 
       RowBox[{"truth", "."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"diskBenchmarkPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"numericSeries", "[", 
          RowBox[{
          "diskSimulationRows", ",", "\"\<Ground-truth bead size (nm)\>\"", 
           ",", "\"\<AUC/fmax length (nm)\>\""}], "]"}], ",", 
         RowBox[{"numericSeries", "[", 
          RowBox[{
          "diskSimulationRows", ",", "\"\<Ground-truth bead size (nm)\>\"", 
           ",", "\"\<FWHM length (nm)\>\""}], "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", "#"}], "}"}], "&"}], ")"}], "/@", 
          "beadDiameterNmValues"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<AUC/fmax\>\"", ",", "\"\<FWHM\>\"", 
          ",", "\"\<Ground truth\>\""}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Ground-truth bead size (nm)\>\"", 
          ",", "\"\<Measured size (nm)\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"ImageSize", "->", "620"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "oval", " ", 
     RowBox[{"signals", ":", 
