   RowBox[{
    RowBox[{
     RowBox[{"aucOverFmaxPixels", "[", "profile_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"values", ",", "peak"}], "}"}], ",", 
       RowBox[{
        RowBox[{"values", "=", 
         RowBox[{"N", "[", "profile", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"peak", "=", 
         RowBox[{"Max", "[", "values", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"NumericQ", "[", "peak", "]"}]}], "||", 
           RowBox[{"peak", "<=", "0"}]}], ",", 
          RowBox[{"Missing", "[", "\"\<NoSignal\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"Total", "[", "values", "]"}], "/", "peak"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"interpolatedFwhmPixels", "[", 
      RowBox[{"profile_", ",", 
       RowBox[{"fraction_", ":", "0.5"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "values", ",", "peak", ",", "threshold", ",", "n", ",", "peakIndex", ",",
          "leftIndex", ",", "rightIndex", ",", "leftCrossing", ",", 
         "rightCrossing", ",", "denominator"}], "}"}], ",", 
       RowBox[{
        RowBox[{"values", "=", 
         RowBox[{"N", "[", "profile", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "values", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"peak", "=", 
         RowBox[{"Max", "[", "values", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"NumericQ", "[", "peak", "]"}]}], "||", 
           RowBox[{"peak", "<=", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<NoSignal\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"threshold", "=", 
         RowBox[{"fraction", " ", "peak"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"peakIndex", "=", 
         RowBox[{"First", "[", 
          RowBox[{"Ordering", "[", 
           RowBox[{"values", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"leftIndex", "=", "peakIndex"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"leftIndex", ">", "1"}], "&&", 
           RowBox[{
            RowBox[{"values", "[", 
             RowBox[{"[", "leftIndex", "]"}], "]"}], ">=", "threshold"}]}], ",", 
          RowBox[{"leftIndex", "--"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"leftCrossing", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"leftIndex", "==", "1"}], "&&", 
            RowBox[{
             RowBox[{"values", "[", 
              RowBox[{"[", "leftIndex", "]"}], "]"}], ">=", "threshold"}]}], ",",
            "1", ",", 
           RowBox[{
            RowBox[{"denominator", "=", 
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"leftIndex", "+", "1"}], "]"}], "]"}], "-", 
              RowBox[{"values", "[", 
               RowBox[{"[", "leftIndex", "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"denominator", "==", "0"}], ",", "leftIndex", ",", 
              RowBox[{"leftIndex", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"threshold", "-", 
                  RowBox[{"values", "[", 
                   RowBox[{"[", "leftIndex", "]"}], "]"}]}], ")"}], "/", 
                "denominator"}]}]}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightIndex", "=", "peakIndex"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rightIndex", "<", "n"}], "&&", 
           RowBox[{
            RowBox[{"values", "[", 
             RowBox[{"[", "rightIndex", "]"}], "]"}], ">=", "threshold"}]}], ",", 
          RowBox[{"rightIndex", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rightCrossing", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rightIndex", "==", "n"}], "&&", 
            RowBox[{
             RowBox[{"values", "[", 
              RowBox[{"[", "rightIndex", "]"}], "]"}], ">=", "threshold"}]}], 
           ",", "n", ",", 
           RowBox[{
            RowBox[{"denominator", "=", 
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", "rightIndex", "]"}], "]"}], "-", 
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"rightIndex", "-", "1"}], "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"denominator", "==", "0"}], ",", "rightIndex", ",", 
              RowBox[{"rightIndex", "-", "1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"threshold", "-", 
                  RowBox[{"values", "[", 
                   RowBox[{"[", 
                    RowBox[{"rightIndex", "-", "1"}], "]"}], "]"}]}], ")"}], "/",
                 "denominator"}]}]}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightCrossing", "-", "leftCrossing"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
