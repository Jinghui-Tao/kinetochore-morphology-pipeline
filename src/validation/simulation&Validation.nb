       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{"measurementColumns", ",", 
          RowBox[{"Lookup", "[", 
           RowBox[{"#", ",", "measurementColumns", ",", 
            RowBox[{"Missing", "[", "\"\<NotApplicable\>\"", "]"}]}], "]"}]}],
          "]"}], "&"}], "/@", "simulationRows"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Representative", " ", "simulated", " ", "images", " ", "for", " ", 
     "visual", " ", 
     RowBox[{"inspection", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"diskExampleImage", "=", 
     RowBox[{"ImageResize", "[", 
      RowBox[{
       RowBox[{"diskSimulationRows", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "\"\<Image\>\""}], "]"}], "]"}], ",", "160"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ovalExampleImage", "=", 
     RowBox[{"ImageResize", "[", 
      RowBox[{
       RowBox[{"FirstCase", "[", 
        RowBox[{"ovalSimulationRows", ",", 
         RowBox[{
          RowBox[{"row_Association", "/;", 
           RowBox[{
            RowBox[{"row", "[", "\"\<End-to-end length d (nm)\>\"", "]"}], "==",
             "700"}]}], ":>", 
          RowBox[{"row", "[", "\"\<Image\>\"", "]"}]}]}], "]"}], ",", "160"}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
