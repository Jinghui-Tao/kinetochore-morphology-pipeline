     RowBox[{"below", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"psfHalfWindowPixels", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Subpixel", " ", "sampling", " ", "smooths", " ", "binary", " ", "object",
      " ", "edges", " ", "without", " ", "changing", " ", "the", " ", 
     "measurement", " ", 
     RowBox[{"method", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subpixelSamplesPerPixel", "=", "4"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"coordinateRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "simulationHalfWindowPixels"}], ",", 
       "simulationHalfWindowPixels"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psfCoordinateRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "psfHalfWindowPixels"}], ",", "psfHalfWindowPixels"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"subpixelOffsets", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Range", "[", "subpixelSamplesPerPixel", "]"}], "-", 
          "0.5"}], ")"}], "/", "subpixelSamplesPerPixel"}], "-", "0.5"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Values", " ", "below", " ", "this", " ", "cutoff", " ", "are", " ", 
      "far", " ", "below", " ", "any", " ", "measurable", " ", 
      RowBox[{"contribution", ".", "Setting"}], " ", "them", " ", "to", " ", 
      "zero", " ", "avoids", " ", "machine"}], "-", 
     RowBox[{
     "underflow", " ", "warnings", " ", "while", " ", "preserving", " ", 
      "the", " ", 
      RowBox[{"result", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"psfTailCutoff", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "250"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"safeGaussianPsfValue", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "exponent", "}"}], ",", 
       RowBox[{
        RowBox[{"exponent", "=", 
         RowBox[{"psfCoefficient", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"exponent", ">", 
           RowBox[{"-", 
            RowBox[{"Log", "[", "psfTailCutoff", "]"}]}]}], ",", "0.", ",", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "exponent"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"psfKernelMatrix", "=", 
     RowBox[{"N", "@", 
